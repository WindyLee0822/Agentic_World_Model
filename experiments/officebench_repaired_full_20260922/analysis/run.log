[officebench-python-error] {"error": "TypeError: 'in <string>' requires string as left operand, not dict", "kind": "success_verdict", "action": null, "code": "import re\n\ndef norm_path(p):\n    if p is None:\n        return None\n    if p.startswith('/testbed/'):\n        p = p[len('/testbed/'):]\n    elif p.startswith('./'):\n        p = p[2:]\n    return p\n\ndef get_content(data, path):\n    p = norm_path(path)\n    fs = data.get('final_state', {})\n    if p in fs:\n        return fs[p]\n    for k, v in fs.items():\n        if norm_path(k) == p:\n            return v\n    return None\n\ndef evaluate_excel_cell_value(data, args):\n    path = args.get('file') or args.get('result_file')\n    content = get_content(data, path)\n    if content is None or content == '[file does not exist]' or content == '[unknown predicted content]':\n        return False\n    matches = args.get('matches', [])\n    for m in matches:\n        if m not in content:\n            return False\n    return True\n\ndef evaluate_excel_cell_comparator(data, args):\n    path = args.get('file') or args.get('result_file')\n    content = get_content(data, path)\n    if content is None or content == '[file does not exist]' or content == '[unknown predicted content]':\n        return False\n    # Parse decoded workbook text of form \"(row, col): value\" separated by tabs/newlines\n    cells = {}\n    for row in re.split(r'[\\t\\n]+', content):\n        row = row.strip()\n        m = re.match(r'^\\((\\d+),\\s*(\\d+)\\):\\s*(.*)$', row)\n        if m:\n            cells[(int(m.group(1)), int(m.group(2)))] = m.group(3)\n\n    def to_num(s):\n        s = str(s).strip()\n        if s == '[Empty Cell]':\n            return None\n        try:\n            return float(s)\n        except:\n            return None\n\n    cell = args.get('cell')\n    if isinstance(cell, (list, tuple)) and len(cell) == 2:\n        key = (int(cell[0]), int(cell[1]))\n    else:\n        m = re.match(r'^\\(?\\s*(\\d+)\\s*,\\s*(\\d+)\\s*\\)?$', str(cell))\n        if not m:\n            return False\n        key = (int(m.group(1)), int(m.group(2)))\n    actual = to_num(cells.get(key, '[Empty Cell]'))\n    expected = to_num(args.get('value'))\n    if actual is None or expected is None:\n        return False\n    op = args.get('comparator') or args.get('operator')\n    if op == '>':\n        return actual > expected\n    elif op == '>=':\n        return actual >= expected\n    elif op == '<':\n        return actual < expected\n    elif op == '<=':\n        return actual <= expected\n    elif op == '==' or op == '=':\n        return actual == expected\n    elif op == '!=':\n        return actual != expected\n    else:\n        return False\n\nverdict = True\nfor ev in data.get('config', {}).get('evaluation', []):\n    fn = ev.get('function')\n    args = ev.get('args', {})\n    if fn == 'evaluate_excel_cell_value':\n        ok = evaluate_excel_cell_value(data, args)\n    elif fn == 'evaluate_excel_cell_comparator':\n        ok = evaluate_excel_cell_comparator(data, args)\n    else:\n        ok = False\n    if not ok:\n        verdict = False\n        break\n\nprint_json({\"verdict\": \"SUCCESS\" if verdict else \"FAILURE\"})", "read_schemas": []}
