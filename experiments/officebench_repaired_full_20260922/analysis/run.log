\n                continue\n            if not in_event:\n                continue\n            if \":\" not in line:\n                continue\n            left, val = line.split(\":\", 1)\n            parts = left.split(\";\")\n            prop = parts[0].upper()\n            params = {}\n            for p in parts[1:]:\n                if \"=\" in p:\n                    k, v = p.split(\"=\", 1)\n                    params[k.upper()] = v\n            if prop in (\"SUMMARY\", \"DESCRIPTION\", \"LOCATION\", \"DTSTART\", \"DTEND\"):\n                current[prop] = (params, val)\n\n        if not events:\n            value = f\"No events found for {username}.\"\n        else:\n            blocks = []\n            for ev in events:\n                summary = unescape_text(ev[\"SUMMARY\"][1]) if \"SUMMARY\" in ev else None\n                description = unescape_text(ev[\"DESCRIPTION\"][1]) if \"DESCRIPTION\" in ev else None\n                location = unescape_text(ev[\"LOCATION\"][1]) if \"LOCATION\" in ev else None\n\n                if \"DTSTART\" in ev:\n                    params, raw = ev[\"DTSTART\"]\n                    start = parse_dt(raw)\n                else:\n                    start = None\n                if \"DTEND\" in ev:\n                    params, raw = ev[\"DTEND\"]\n                    end = parse_dt(raw)\n                else:\n                    end = None\n\n                block = \"\\n\".join([\n                    f\"Summary: {summary}\",\n                    f\"Start Time: {start}\",\n                    f\"End Time: {end}\",\n                    f\"Description: {description}\",\n                    f\"Location: {location}\",\n                    \"-\" * 50,\n                ])\n                blocks.append(block)\n            value = f\"Successfully list events for {username}:\\n\" + \"\\n\".join(blocks).rstrip()\n    except Exception:\n        value = f\"Failed to list events for {username}.\"\n\nprint_json({\"text\": value})", "re