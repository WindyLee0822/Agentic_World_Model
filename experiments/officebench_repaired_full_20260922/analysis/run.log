[officebench-python-error] {"error": "TypeError: 'in <string>' requires string as left operand, not dict", "kind": "success_verdict", "action": null, "code": "import re\n\ndef norm_path(p):\n    if p is None:\n        return None\n    if p.startswith('/testbed/'):\n        p = p[len('/testbed/'):]\n    elif p.startswith('./'):\n        p = p[2:]\n    return p\n\ndef get_content(data, path):\n    p = norm_path(path)\n    fs = data.get('final_state', {})\n    if p in fs:\n        return fs[p]\n    if path in fs:\n        return fs[path]\n    return None\n\ndef evaluate_excel_cell_value(data, args):\n    path = args.get('file') or args.get('result_file')\n    content = get_content(data, path)\n    if content is None or content in ('[file does not exist]', '[unknown predicted content]'):\n        return None\n    for m in args.get('matches', []):\n        if m not in content:\n            return False\n    return True\n\ndef parse_cells(text):\n    cells = {}\n    if text is None:\n        return cells\n    for r, c, v in re.findall(r'\\((\\d+),\\s*(\\d+)\\):\\s*([^\\t\\n\\r]*)', text):\n        cells[(int(r), int(c))] = v\n    return cells\n\ndef to_num(s):\n    s = s.strip()\n    try:\n        return float(s)\n    except:\n        return None\n\ndef compare(a, op, b):\n    an = to_num(a)\n    bn = to_num(b)\n    if an is None or bn is None:\n        return None\n    if op == '==':\n        return an == bn\n    elif op == '!=':\n        return an != bn\n    elif op == '>':\n        return an > bn\n    elif op == '<':\n        return an < bn\n    elif op == '>=':\n        return an >= bn\n    elif op == '<=':\n        return an <= bn\n    return None\n\ndef evaluate_excel_cell_comparator(data, args):\n    path = args.get('file') or args.get('result_file')\n    content = get_content(data, path)\n    if content is None or content in ('[file does not exist]', '[unknown predicted content]'):\n        return None\n    cells = parse_cells(content)\n    checks = args.get('matches', args.get('comparisons', []))\n    for chk in checks:\n        if isinstance(chk, str):\n            m = re.match(r'\\((\\d+),\\s*(\\d+)\\)\\s*([!<>=]+)\\s*(.+)$', chk)\n            if not m:\n                return None\n            row, col, op, expected = int(m.group(1)), int(m.group(2)), m.group(3), m.group(4)\n        else:\n            row = chk.get('row')\n            col = chk.get('col', chk.get('column'))\n            op = chk.get('comparator', chk.get('operator', chk.get('op')))\n            expected = str(chk.get('value'))\n        actual = cells.get((row, col))\n        if actual is None:\n            return False\n        res = compare(actual, op, str(expected))\n        if res is None:\n            return None\n        if not res:\n            return False\n    return True\n\nverdict = \"SUCCESS\"\nfor ev in data.get('config', {}).get('evaluation', []):\n    fn = ev.get('function')\n    args = ev.get('args', {})\n    if fn == 'evaluate_excel_cell_value':\n        res = evaluate_excel_cell_value(data, args)\n    elif fn == 'evaluate_excel_cell_comparator':\n        res = evaluate_excel_cell_comparator(data, args)\n    else:\n        res = None\n    if res is not True:\n        verdict = \"FAILURE\"\n        break\n\nprint_json({\"verdict\": verdict})", "read_schemas": []}
