while j < len(folded) and folded[j].rstrip(\"\\r\\n\") != \"END:VEVENT\":\n                j += 1\n            if j < len(folded):\n                events.append((start, j))\n                i = j\n        i += 1\n\n    remove_ranges = []\n    for start, end in events:\n        ev_lines = folded[start:end+1]\n        unfolded_ev = []\n        for ln in ev_lines:\n            if (ln.startswith(\" \") or ln.startswith(\"\\t\")) and unfolded_ev:\n                unfolded_ev[-1] = unfolded_ev[-1].rstrip(\"\\r\\n\") + ln[1:]\n            else:\n                unfolded_ev.append(ln)\n        if prop_value(unfolded_ev, \"SUMMARY\") == summary:\n            remove_ranges.append((start, end))\n\n    if not remove_ranges:\n        return content\n\n    keep = []\n    idx = 0\n    rr = iter(remove_ranges)\n    current = next(rr, None)\n    while idx < len(folded):\n        if current and current[0] <= idx <= current[1]:\n            idx = current[1] + 1\n            current = next(rr, None)\n        else:\n            keep.append(folded[idx])\n            idx += 1\n    return \"\".join(keep)\n\ndef append_event(content, action):\n    newline = \"\\r\\n\" if \"\\r\\n\" in content else \"\\n\"\n    if content == \"\":\n        header = [\n            \"BEGIN:VCALENDAR\" + newline,\n            \"VERSION:2.0\" + newline,\n            \"PRODID:-//OfficeBench//Calendar//EN\" + newline,\n            \"END:VCALENDAR\" + newline,\n        ]\n        content = \"\".join(header)\n\n    lines = fold_lines(content)\n    end_idx = None\n    for i, ln in enumerate(lines):\n        if ln.rstrip(\"\\r\\n\") == \"END:VCALENDAR\":\n            end_idx = i\n            break\n    if end_idx is None:\n        return content\n\n    summary = get_arg(action, \"summary\", \"event_title\", \"title\")\n    start = get_arg(action, \"start_time\", \"start\")\n    end = get_arg(action, \"end_time\", \"end\")\n    description = get_arg(action, \"description\")\n    location = get_arg(action, \"location\")\n\n    ev = []\n    ev.append(\"BEGIN:VEVENT\" + newline)\n    if summary is not None:\n        ev.append(f\"SUMMARY:{summary}\" + newline)\n    if start is not None:\n        ev.append(f\"DTSTART:{start}\" + newline)\n    if end is not None:\n        ev.append(f\"DTEND:{end}\" + newline)\n    if description is not None:\n        ev.append(f\"DESCRIPTION:{description}\" + newline)\n    if location is not None:\n        ev.append(f\"LOCATION:{location}\" + newline)\n    ev.append(\"END:VEVENT\" + newline)\n\n    new_lines = lines[:end_idx] + ev + lines[end_idx:]\n    return \"\".join(new_lines)\n\nall_writes = []\nfor seq_name in (\"global_writes\", \"writes\"):\n    seq = data.get(seq_name) or []\n    for entry in seq:\n        if entry.get(\"applied\") is False:\n            continue\n        action = entry.get(\"action\") or {}\n        if action.get(\"app\") != \"calendar\":\n            continue\n        p = norm(get_arg(action, \"file_path\", \"path\", \"calendar_file\", \"filename\", \"target\"))\n        if target and p and norm(target) != p:\n            continue\n        all_writes.append(action)\n\nfor action in all_writes:\n    name = action.get(\"action\")\n    if name == \"create_event\":\n        text = append_event(text, action)\n    elif name in (\"delete_event\", \"remove_event\"):\n        summary = get_arg(action, \"summary\", \"event_title\", \"title\")\n        if summary is not None:\n            text = remove_event_by_summary(text, summary)\n\nprint_json({\"text\": text})", "read_schemas": []}
