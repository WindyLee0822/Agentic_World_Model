cell\":\n        row = action.get(\"row\")\n        col = action.get(\"column\")\n        if row is None:\n            row = action.get(\"row_number\")\n        if col is None:\n            col = action.get(\"col\")\n        if col is None:\n            col = action.get(\"column_number\")\n        try:\n            row = int(row)\n            col = int(col)\n        except Exception:\n            continue\n        cells[(row, col)] = None\n\nif cells:\n    max_row = max(r for r, c in cells.keys())\n    max_col = max(c for r, c in cells.keys())\nelse:\n    max_row = max_col = 0\n\nlines = []\nfor r in range(1, max_row + 1):\n    parts = []\n    for c in range(1, max_col + 1):\n        v = cells.get((r, c), None)\n        if v is None:\n            s = \"[Empty Cell]\"\n        else:\n            s = str(v)\n        parts.append(f\"({r}, {c}): {s}\")\n    lines.append(\"\\t\".join(parts))\nvalue = \"\\n\".join(lines)\n\nprint_json({\"text\": value})", "read_schemas": []}
