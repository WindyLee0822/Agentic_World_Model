\n                    if depth == 0:\n                        blocks.append((start, j))\n                        i = j\n                        break\n                j += 1\n        i += 1\n    return blocks\n\ndef get_prop_value(block_lines, prop_name):\n    for line in block_lines:\n        name, params, value, eol = parse_prop(line)\n        if name == prop_name:\n            return value\n    return None\n\ndef normalize_dt(s):\n    if s is None:\n        return None\n    return str(s)\n\ndef action_matches_target(action, target_path):\n    for k in (\"file_path\", \"path\", \"calendar_file\", \"calendar_path\", \"filename\", \"target\"):\n        if k in action and action[k] == target_path:\n            return True\n    return False\n\ntarget = data.get(\"target\")\nlines = unfold_ics_lines(content)\n\nfor action in writes:\n    if action.get(\"app\") != \"calendar\":\n        continue\n    if target is not None and not action_matches_target(action, target):\n        continue\n\n    act = action.get(\"action\")\n    if act == \"create_event\":\n        summary = action.get(\"summary\", \"\")\n        start_time = action.get(\"start_time\", \"\")\n        end_time = action.get(\"end_time\", \"\")\n        description = action.get(\"description\", \"\")\n        location = action.get(\"location\", \"\")\n\n        eol = \"\\n\"\n        m = re.search(r\"\\r\\n|\\n|\\r\", content)\n        if m:\n            eol = m.group(0)\n\n        insert_at = len(lines)\n        for idx, line in enumerate(lines):\n            name, params, value, leol = parse_prop(line)\n            if name == \"END\" and value == \"VCALENDAR\":\n                insert_at = idx\n                break\n\n        new_block = [\n            \"BEGIN:VEVENT\" + eol,\n            \"SUMMARY:\" + str(summary) + eol,\n            \"DTSTART:\" + str(start_time) + eol,\n            \"DTEND:\" + str(end_time) + eol,\n            \"DESCRIPTION:\" + str(description) + eol,\n            \"LOCATION:\" + str(location) + eol,\n            \"END:VEVENT\" + eol,\n        ]\n        lines[insert_at:insert_at] = new_block\n\n    elif act == \"delete_event\":\n        summary = action.get(\"summary\")\n        start_time = action.get(\"start_time\")\n        end_time = action.get(\"end_time\")\n\n        blocks = find_vevent_blocks(lines)\n        remove = None\n        for s, e in blocks:\n            block = lines[s:e+1]\n            b_summary = get_prop_value(block, \"SUMMARY\")\n            b_start = get_prop_value(block, \"DTSTART\")\n            b_end = get_prop_value(block, \"DTEND\")\n            ok = True\n            if summary is not None:\n                ok = ok and (b_summary == str(summary))\n            if start_time is not None:\n                ok = ok and (normalize_dt(b_start) == normalize_dt(start_time))\n            if end_time is not None:\n                ok = ok and (normalize_dt(b_end) == normalize_dt(end_time))\n            if ok:\n                remove = (s, e)\n                break\n        if remove is not None:\n            s, e = remove\n            del lines[s:e+1]\n\nfinal_text = \"\".join(lines)\nprint_json({\"text\": final_text})", "read_schemas": []}
