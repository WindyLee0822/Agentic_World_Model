f evaluate_excel_cell_comparator(data, args):\n    path = args.get('file') or args.get('result_file')\n    content = get_content(data, path)\n    if content is None or content in ('[file does not exist]', '[unknown predicted content]'):\n        return None\n    cells = parse_cells(content)\n    checks = args.get('checks') or args.get('comparisons') or args.get('matches') or []\n    if not checks:\n        return None\n    for chk in checks:\n        if isinstance(chk, dict):\n            row = chk.get('row')\n            col = chk.get('col') or chk.get('column')\n            op = chk.get('comparator') or chk.get('operator') or chk.get('op')\n            expected = chk.get('value') if 'value' in chk else chk.get('expected')\n            if row is None or col is None or op is None or expected is None:\n                return None\n            actual = cells.get((int(row), int(col)))\n            if actual is None:\n                return False\n            if compare(actual, str(op), str(expected)) is not True:\n                return False\n        else:\n            m = re.match(r'\\((\\d+),\\s*(\\d+)\\)\\s*(==|!=|>=|<=|>|<)\\s*(.+)', str(chk).strip())\n            if not m:\n                return None\n            row, col, op, expected = int(m.group(1)), int(m.group(2)), m.group(3), m.group(4).strip()\n            actual = cells.get((row, col))\n            if actual is None:\n                return False\n            if compare(actual, op, expected) is not True:\n                return False\n    return True\n\nverdict = \"SUCCESS\"\nfor ev in (data.get('config', {}) or {}).get('evaluation', []):\n    fn = ev.get('function')\n    args = ev.get('args', {}) or {}\n    if fn == 'evaluate_excel_cell_value':\n        res = evaluate_excel_cell_value(data, args)\n    elif fn == 'evaluate_excel_cell_comparator':\n        res = evaluate_excel_cell_comparator(data, args)\n    else:\n        res = None\n    if res is not True:\n        verdict = \"FAILURE\"\n        break