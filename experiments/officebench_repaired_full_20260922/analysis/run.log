N:VEVENT\":\n            in_event = True\n            cur = {\"lines\": [], \"props\": {}}\n            continue\n        if line == \"END:VEVENT\":\n            if cur is not None:\n                events.append(cur)\n            in_event = False\n            cur = None\n            continue\n        if in_event and cur is not None:\n            cur[\"lines\"].append(line)\n            if \":\" in line:\n                k, v = line.split(\":\", 1)\n                cur[\"props\"][k] = v\n    return events\n\ndef build_event(action):\n    uid = action.get(\"uid\")\n    summary = action.get(\"summary\")\n    start = action.get(\"start_time\")\n    end = action.get(\"end_time\")\n    description = action.get(\"description\")\n    location = action.get(\"location\")\n    lines = [\"BEGIN:VEVENT\"]\n    if uid is not None:\n        lines.extend(fold_ics_line(\"UID:\" + escape_text(uid)))\n    if summary is not None:\n        lines.extend(fold_ics_line(\"SUMMARY:\" + escape_text(summary)))\n    if start is not None:\n        lines.extend(fold_ics_line(\"DTSTART:\" + format_dt(start)))\n    if end is not None:\n        lines.extend(fold_ics_line(\"DTEND:\" + format_dt(end)))\n    if description is not None:\n        lines.extend(fold_ics_line(\"DESCRIPTION:\" + escape_text(description)))\n    if location is not None:\n        lines.extend(fold_ics_line(\"LOCATION:\" + escape_text(location)))\n    lines.append(\"END:VEVENT\")\n    return lines\n\nfor act in writes:\n    name = act.get(\"action\")\n    if name == \"create_event\":\n        new_lines = build_event(act)\n        if \"BEGIN:VCALENDAR\" in text and \"END:VCALENDAR\" in text:\n            idx = text.rfind(\"END:VCALENDAR\")\n            prefix = text[:idx]\n            suffix = text[idx:]\n            sep = \"\" if prefix.endswith(\"\\n\") or prefix == \"\" else \"\\n\"\n            text = prefix + sep + \"\\n\".join(new_lines) + (\"\\n\" if not \"\\n\".join(new_lines).endswith(\"\\n\") else \"\") + suffix\n        else:\n            text = \"BEGIN:VCALENDAR\\nVERSION:2.0\\n\" + \"\\n\".join(new_lines) + \"\\nEND:VCALENDAR\"\n    elif name in (\"delete_event\", \"remove_event\"):\n        uid = act.get(\"uid\")\n        if uid is None:\n            continue\n        lines = unfold_lines(text)\n        out = []\n        in_event = False\n        cur = []\n        cur_uid = None\n        for line in lines:\n            if line == \"BEGIN:VEVENT\":\n                in_event = True\n                cur = [line]\n                cur_uid = None\n                continue\n            if in_event:\n                cur.append(line)\n                if line.startswith(\"UID:\"):\n                    cur_uid = line.split(\":\", 1)[1]\n                if line == \"END:VEVENT\":\n                    if cur_uid != str(uid):\n                        out.extend(cur)\n                    in_event = False\n                    cur = []\n                    cur_uid = None\n                continue\n            out.append(line)\n        text = \"\\n\".join(out)\n    elif name in (\"update_event\", \"edit_event\"):\n        uid = act.get(\"uid\")\n        if uid is None:\n            continue\n        events = parse_events(text)\n        target = None\n        for ev in events:\n            if ev[\"props\"].get(\"UID\") == str(uid):\n                target = ev\n                break\n        if target is None:\n            continue\n        props = dict(target[\"props\"])\n        mapping = {\n            \"summary\": \"SUMMARY\",\n            \"start_time\": \"DTSTART\",\n            \"end_time\": \"DTEND\",\n            \"description\": \"DESCRIPTION\",\n            \"location\": \"LOCATION\",\n        }\n        for ak, pk in mapping.items():\n            if ak in act:\n                val = act.get(ak)\n                if pk in (\"DTSTART\", \"DTEND\"):\n                    props[pk] = format_dt(val)\n                else:\n                    props[pk] = escape_text(val)\n        new_event = [\"BEGIN:VEVENT\"]\n        ordered = []\n        seen = set()\n        for line in target[\"lines\"]:\n            if \":\" not in line:\n                continue\n            k = line.split(\":\", 1)[0]\n            base = k.split(\";\", 1)[0]\n            if base in props and base not in seen:\n                ordered.append(base)\n                seen.add(base)\n        for k in [\"UID\", \"SUMMARY\", \"DTSTART\", \"DTEND\", \"DESCRIPTION\", \"LOCATION\"]:\n            if k in props and k not in seen:\n                ordered.append(k)\n                seen.add(k)\n        for k in ordered:\n            new_event.extend(fold_ics_line(k + \":\" + props[k]))\n        new_event.append(\"END:VEVENT\")\n\n        lines = unfold_lines(text)\n        out = []\n        in_event = False\n        cur = []\n        cur_uid = None\n        replaced = False\n        for line in lines:\n            if line == \"BEGIN:VEVENT\":\n                in_event = True\n                cur = [line]\n                cur_uid = None\n                continue\n            if in_event:\n                cur.append(line)\n                if line.startswith(\"UID:\"):\n                    cur_uid = line.split(\":\", 1)[1]\n                if line == \"END:VEVENT\":\n                    if not replaced and cur_uid == str(uid):\n                        out.extend(new_event)\n                        replaced = True\n                    else:\n                        out.extend(cur)\n                    in_event = False\n                    cur = []\n                    cur_uid = None\n                continue\n            out.append(line)\n        text = \"\\n\".join(out)\n\nprint_json({\"text\": text})", "read_schemas": []}
