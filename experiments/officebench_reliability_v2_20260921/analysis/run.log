d\") or w.get(\"args\", {}).get(\"command\") or \"\"\n    c = cmd.strip()\n\n    # mkdir -p paths...\n    if c.startswith(\"mkdir \"):\n        toks = c.split()\n        paths = [t for t in toks[1:] if not t.startswith(\"-\")]\n        for p in paths:\n            p = norm(p)\n            cur = \"\"\n            for part in [x for x in p.split(\"/\") if x]:\n                cur += \"/\" + part\n                ensure_dir(tree, cur)\n        continue\n\n    # touch paths...\n    if c.startswith(\"touch \"):\n        toks = c.split()\n        for p in toks[1:]:\n            p = norm(p)\n            par = parent(p)\n            if par and par in tree and tree.get(par) == \"dir\":\n                ensure_file(tree, p)\n        continue\n\n    # rm / rm -r / rm -rf\n    if c.startswith(\"rm \"):\n        toks = c.split()\n        paths = [t for t in toks[1:] if not t.startswith(\"-\")]\n        for p in paths:\n            remove_path(tree, p)\n        continue\n\n    # mv src dst\n    if c.startswith(\"mv \"):\n        toks = c.split()\n        if len(toks) >= 3:\n            src = norm(toks[1]); dst = norm(toks[2])\n            if src in tree:\n                typ = tree[src]\n                # move subtree\n                moved = {}\n                for k, v in list(tree.items()):\n                    if k == src or k.startswith(src + \"/\"):\n                        suffix = k[len(src):]\n                        moved[dst + suffix] = v\n                        del tree[k]\n                par = parent(dst)\n                if par and tree.get(par) == \"dir\":\n                    tree.update(moved)\n        continue\n\n    # cp src dst (file only conservatively)\n    if c.startswith(\"cp \"):\n        toks = c.split()\n        if len(toks) >= 3:\n            src = norm(toks[1]); dst = norm(toks[2])\n            if tree.get(src) == \"file\":\n                par = parent(dst)\n                if par and tree.get(par) == \"dir\":\n                    ensure_file(tree,